msgid "You do not have sufficient permissions to access this page."
msgstr "Non hai i permessi necessari per accedere a questa pagina."

msgid "[PaperPlane Mail Test child site] %s — %s"
msgstr "[PaperPlane Mail Test child site] %s — %s"

msgid "Automatic mail function test from %s."
msgstr "Test automatico della funzione mail da %s."

msgid "Mail sent successfully."
msgstr "Mail inviata correttamente."

msgid "wp_mail() returned false."
msgstr "wp_mail() ha restituito false."

msgid "PaperPlane Mail Test"
msgstr "PaperPlane Mail Test"

msgid "This plugin exposes a REST endpoint that the PaperPlane assistance site can call to verify the mail function works correctly."
msgstr "Questo plugin espone un endpoint REST che il sito assistenza PaperPlane può chiamare per verificare che la funzione mail funzioni correttamente."

msgid "1. Secret key"
msgstr "1. Chiave segreta"

msgid "Key verified and active. The value will no longer be shown."
msgstr "Chiave verificata e attiva. Il valore non verrà più mostrato."

msgid "%s is not defined in %s. Add the line shown below and try again."
msgstr "%s non è definita in %s. Aggiungi la riga mostrata qui sotto e riprova."

msgid "The key does not match. Make sure you copied the value shown below exactly into %s."
msgstr "La chiave non corrisponde. Assicurati di aver copiato esattamente il valore mostrato qui sotto in %s."

msgid "Key active — %s is defined in %s."
msgstr "Chiave attiva — %s è definita in %s."

msgid "Copy this key now — it will no longer be shown after verification."
msgstr "Copia questa chiave ora — non sarà più visibile dopo la verifica."

msgid "Copy"
msgstr "Copia"

msgid "Copied!"
msgstr "Copiato!"

msgid "Add this line to %s before %s:"
msgstr "Aggiungi questa riga in %s prima di %s:"

msgid "Once you have added the line, click the button below to verify the configuration."
msgstr "Dopo aver aggiunto la riga, clicca il pulsante qui sotto per verificare la configurazione."

msgid "Verify configuration"
msgstr "Verifica configurazione"

msgid "Generate a different key"
msgstr "Genera una chiave diversa"

msgid "Generate a new key? The current key shown will be replaced."
msgstr "Generare una nuova chiave? La chiave attualmente mostrata verrà sostituita."

msgid "Regenerate key"
msgstr "Rigenera chiave"

msgid "Regenerate the secret key? You will need to update wp-config.php with the new value."
msgstr "Rigenerare la chiave segreta? Dovrai aggiornare wp-config.php con il nuovo valore."

msgid "2. Assistance site data"
msgstr "2. Dati per il sito assistenza"

msgid "Site URL"
msgstr "URL sito"

msgid "Secret key"
msgstr "Chiave segreta"

msgid "Add the key to wp-config.php first"
msgstr "Aggiungi prima la chiave in wp-config.php"

msgid "New key generated. Copy it and update the main plugin configuration."
msgstr "Nuova chiave generata. Copiala e aggiorna la configurazione nel plugin principale."

msgid "A secret key has been generated automatically. Copy it and add this site to the main plugin."
msgstr "Una chiave segreta è stata generata automaticamente. Copiala e aggiungi questo sito al plugin principale."

msgid "Key active — stored securely in the database."
msgstr "Chiave attiva — salvata in modo sicuro nel database."

msgid "Show key"
msgstr "Mostra chiave"

msgid "Hide key"
msgstr "Nascondi chiave"

msgid "Regenerate the secret key? The old key will stop working immediately — update the main plugin configuration with the new key."
msgstr "Rigenerare la chiave segreta? La vecchia chiave smetterà di funzionare immediatamente — aggiorna la configurazione nel plugin principale con la nuova chiave."

msgid "PaperPlane Mail Test:"
msgstr "PaperPlane Mail Test:"

msgid "the secret key has not been copied yet."
msgstr "la chiave segreta non è stata ancora copiata."

msgid "Copy it now →"
msgstr "Copiala ora →"

msgid "Copy the key now."
msgstr "Copia la chiave ora."

msgid "Clicking \"Copy key\" will permanently hide it. Make sure to paste it into the main plugin before proceeding — it cannot be recovered, only regenerated."
msgstr "Cliccando \"Copia chiave\" verrà nascosta definitivamente. Incollala nel plugin principale prima di procedere — non potrà essere recuperata, solo rigenerata."

msgid "Copy key"
msgstr "Copia chiave"

msgid "Could not copy automatically. Copy the key manually from the field above, then click the button below."
msgstr "Impossibile copiare automaticamente. Copia la chiave manualmente dal campo qui sopra, poi clicca il pulsante qui sotto."

msgid "I have copied the key"
msgstr "Ho copiato la chiave"

msgid "Generate new key"
msgstr "Genera nuova chiave"

msgid "Generating a new key will immediately invalidate the current one — update the main plugin configuration afterwards."
msgstr "Generare una nuova chiave invaliderà immediatamente quella attuale — aggiorna la configurazione nel plugin principale dopo."

msgid "Hidden — generate a new key if you need to reconfigure."
msgstr "Nascosta — genera una nuova chiave se devi riconfigurare."

msgid "Regenerate the secret key? The current key will stop working immediately — you will need to update the main plugin with the new key."
msgstr "Rigenerare la chiave segreta? Quella attuale smetterà di funzionare immediatamente — aggiorna il plugin principale con la nuova chiave."

msgid "New key generated. Copy it now — it will be hidden after you click \"Copy key\"."
msgstr "Nuova chiave generata. Copiala ora — verrà nascosta dopo aver cliccato \"Copia chiave\"."

msgid "A secret key has been generated automatically. Copy it now — it will be hidden after you click \"Copy key\"."
msgstr "Una chiave segreta è stata generata automaticamente. Copiala ora — verrà nascosta dopo aver cliccato \"Copia chiave\"."
